<Ui xmlns="http://www.blizzard.com/wow/ui/" 
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
    
    <!-- Key Binding Registration -->
    <Script>
        _G["BINDING_HEADER_BOBBERBUDDY"] = "BobberBuddy";
        _G["BINDING_NAME_CLICK BobberBuddyFishingButton:LeftButton"] = "Fish (Cast/Click Bobber)";
    </Script>

    <!-- BobberBuddy Fish List Template -->
    <Frame name="BobberBuddyFishItemTemplate" virtual="true">
        <Size x="160" y="20"/>
        <Layers>
            <Layer level="OVERLAY">
                <FontString name="$parentName" inherits="GameFontHighlight" justifyH="LEFT">
                    <Size x="100" y="20"/>
                    <Anchors>
                        <Anchor point="LEFT" x="5" y="0"/>
                    </Anchors>
                </FontString>
                <FontString name="$parentCount" inherits="GameFontHighlight" justifyH="RIGHT">
                    <Size x="50" y="20"/>
                    <Anchors>
                        <Anchor point="RIGHT" x="-5" y="0"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
    </Frame>
    
    <!-- BobberBuddy Minimap Button Template (for future use) -->
    <Button name="BobberBuddyMinimapButtonTemplate" frameStrata="MEDIUM" parent="Minimap" hidden="true" virtual="true">
        <Size x="32" y="32"/>
        <Anchors>
            <Anchor point="CENTER" relativeTo="Minimap" relativePoint="CENTER"/>
        </Anchors>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture name="$parentIcon" file="Interface\AddOns\BobberBuddy\icon">
                    <Size x="20" y="20"/>
                    <Anchors>
                        <Anchor point="CENTER" x="0" y="0"/>
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="OVERLAY">
                <Texture file="Interface\Minimap\MiniMap-TrackingBorder">
                    <Size x="54" y="54"/>
                    <Anchors>
                        <Anchor point="CENTER" x="11" y="-11"/>
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>
        <HighlightTexture file="Interface\Minimap\UI-Minimap-ZoomButton-Highlight" alphaMode="ADD">
            <Size x="32" y="32"/>
            <Anchors>
                <Anchor point="CENTER" x="0" y="0"/>
            </Anchors>
        </HighlightTexture>
        <Scripts>
            <OnLoad>
                self:RegisterForDrag("LeftButton")
            </OnLoad>
            <OnDragStart>
                self:StartMoving()
            </OnDragStart>
            <OnDragStop>
                self:StopMovingOrSizing()
            </OnDragStop>
            <OnClick>
                -- Toggle tracker frame visibility
                if BobberBuddy and BobberBuddy.ui and BobberBuddy.ui.trackerFrame then
                    if BobberBuddy.ui.trackerFrame:IsVisible() then
                        BobberBuddy.ui.trackerFrame:Hide()
                        BobberBuddy.db.showTracker = false
                    else
                        BobberBuddy.ui.trackerFrame:Show()
                        BobberBuddy.db.showTracker = true
                    end
                end
            </OnClick>
        </Scripts>
    </Button>
</Ui>
